      body, .color-background-1, .color-background-2, .color-inverse, .color-accent-1, .color-accent-2, .color-scheme-d16cc244-fcd2-4019-b3ce-edb00b324a4e, .color-scheme-23819d3b-9d62-417e-88e3-7c62d204c41f {
